# Backend-only secrets. Never use VITE_ for keys or the organizer URL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
ORGANIZER_DEV_API_URL=
DATABASE_URL=sqlite:///./cqa.db
ALLOW_EXTERNAL_LLM_FOR_REAL_CALLS=false
MAX_PARALLEL_EVALUATIONS=3
EVALUATION_TIMEOUT_SECONDS=90
# Optional USD per 1 million tokens. Blank means cost unknown, not zero.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
ENABLE_AUDIO_ANALYTICS=false
